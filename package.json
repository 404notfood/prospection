{
  "name": "prospection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "worker": "tsx scripts/automation-worker.ts",
    "worker:check": "tsx scripts/automation-worker.ts --check",
    "worker:dev": "tsx scripts/automation-worker.ts --dev",
    "lint": "eslint",
    "types": "next typegen && tsc --noEmit",
    "account:setup": "tsx scripts/setup-account.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib scripts tests README.md next.config.ts",
    "format:check": "prettier --check app components lib scripts tests README.md next.config.ts",
    "check:lines": "tsx scripts/check-lines.ts",
    "db:setup": "tsx scripts/setup-database.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
